{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "main"
    },
    "preview": {
      "distribution": "internal",
      "channel": "main"
    },
    "pitch-demo": {
      "distribution": "internal",
      "channel": "pitch-demo",
      "env": {
        "EXPO_PUBLIC_FIREBASE_TARGET": "demo"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "main"
    }
  },
  "submit": {
    "production": {}
  }
}
